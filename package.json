{
  "name": "texypaper",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSoo-Kim/texypaper.git"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "package:release": "node scripts/package-release.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:preferences": "node scripts/smoke-preferences.mjs",
    "smoke:usability": "node scripts/smoke-usability.mjs",
    "smoke:features": "node scripts/smoke-features.mjs",
    "smoke:ssh": "node scripts/smoke-ssh.mjs",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "smoke:chat": "node scripts/smoke-chat.mjs",
    "smoke:tray": "node scripts/smoke-tray.mjs",
    "measure:memory": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/measure-memory.ps1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "~2.12.4",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.56.0",
    "ssh2": "^1.17.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}