{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TexyPaper",
  "version": "0.0.8",
  "identifier": "dev.texypaper.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "TexyPaper",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://texypaper.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://texypaper.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": [
        "default",
        "chat"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "homepage": "https://github.com/HSoo-Kim/texypaper",
    "shortDescription": "Local and SSH paper workspace",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}